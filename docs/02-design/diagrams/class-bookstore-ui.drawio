        <mxCell id="n18" value="Purple: design tokens (tokens.dart)&#10;Blue: reusable widgets&#10;Grey: the theme (theme.dart)&#10;&#10;Every widget reads its colors from&#10;BookstoreColors.of(context), so it follows&#10;light and dark mode automatically." style="shape=note;size=14;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="600" width="270" height="150" as="geometry" /></mxCell>
