        <mxCell id="n17" value="Every Api method is async and returns a&#10;Future. Screens await it and show a loading&#10;state, so the window never freezes (N2).&#10;&#10;Rent charge = 10% of the price.&#10;Rent due date = order date + 7 days." style="shape=note;size=14;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="320" width="270" height="130" as="geometry" /></mxCell>
        <mxCell id="n18" value="Colors&#10;Blue: screens (Flutter widgets)&#10;Green: calls to the web services&#10;Yellow: data&#10;Grey: application, session, order draft" style="shape=note;size=14;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="760" width="270" height="110" as="geometry" /></mxCell>
