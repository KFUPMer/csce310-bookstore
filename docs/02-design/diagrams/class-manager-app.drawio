        <mxCell id="n14" value="Only a session with the MANAGER role can&#10;get past the login screen (FR11, N5).&#10;&#10;Every Api method is async and returns a&#10;Future. Screens await it and show a loading&#10;state, so the window never freezes (N2)." style="shape=note;size=14;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="540" width="270" height="110" as="geometry" /></mxCell>
        <mxCell id="n15" value="Colors&#10;Blue: screens (Flutter widgets)&#10;Green: calls to the web services&#10;Yellow: data&#10;Grey: application, session, order draft" style="shape=note;size=14;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="760" width="270" height="110" as="geometry" /></mxCell>
