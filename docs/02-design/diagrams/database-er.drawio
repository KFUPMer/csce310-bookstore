        <mxCell id="sessions" value="SESSIONS" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sessionsF" value="PK  token : VARCHAR&#10;FK  user_id : INT&#10;created_at : DATETIME" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=12;" vertex="1" parent="sessions">
          <mxGeometry y="30" width="260" height="80" as="geometry" />
