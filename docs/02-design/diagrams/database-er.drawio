        <mxCell id="orders" value="ORDERS" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ordersF" value="PK  id : INT&#10;FK  user_id : INT&#10;payment_status : ENUM(PENDING, PAID)&#10;total : DECIMAL&#10;bill_file : VARCHAR&#10;created_at : DATETIME" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=12;" vertex="1" parent="orders">
          <mxGeometry y="30" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="items" value="ORDER_ITEMS" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="260" height="165" as="geometry" />
        </mxCell>
        <mxCell id="itemsF" value="PK  id : INT&#10;FK  order_id : INT&#10;book_id : VARCHAR (MongoDB id)&#10;title : VARCHAR&#10;type : ENUM(BUY, RENT)&#10;quantity : INT&#10;unit_price : DECIMAL" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=12;" vertex="1" parent="items">
          <mxGeometry y="30" width="260" height="135" as="geometry" />
