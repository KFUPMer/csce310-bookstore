        <mxCell id="r1" value="places" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERzeroToMany;startArrow=ERmandOne;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="users" target="orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="contains" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERoneToMany;startArrow=ERmandOne;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="orders" target="items">
          <mxGeometry relative="1" as="geometry" />
