        <mxCell id="r4" value="has" style="endArrow=ERzeroToMany;startArrow=ERmandOne;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="users" target="sessions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="book_id refers to _id&#10;(no foreign key across databases)" style="dashed=1;endArrow=open;startArrow=none;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="items" target="books">
          <mxGeometry relative="1" as="geometry" />
