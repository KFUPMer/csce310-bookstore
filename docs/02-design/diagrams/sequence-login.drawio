<mxfile host="app.diagrams.net">
  <diagram id="sequence-login" name="Sequence: log in">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="User&lt;br&gt;(customer or manager)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="25" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="90" as="sourcePoint" /><mxPoint x="100" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c3" value="Desktop app&lt;br&gt;(Flutter)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="285" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="90" as="sourcePoint" /><mxPoint x="360" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c5" value="user-service&lt;br&gt;(HttpServer)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="545" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="90" as="sourcePoint" /><mxPoint x="620" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c7" value="MySQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="805" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="90" as="sourcePoint" /><mxPoint x="880" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c9" value="1. enter username and password, click &quot;Log in&quot;" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="140" as="sourcePoint" /><mxPoint x="360" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c10" value="2. POST /api/auth/login — asynchronous" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="190" as="sourcePoint" /><mxPoint x="620" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c11" value="3. find user by username" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="240" as="sourcePoint" /><mxPoint x="880" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c12" value="4. user row (password hash, role)" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="290" as="sourcePoint" /><mxPoint x="620" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c13" value="5. compare the password with the bcrypt hash" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="632" y="310" width="185" height="56" as="geometry" /></mxCell>
        <mxCell id="c14" value="" style="endArrow=none;html=1;strokeColor=#333333;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="400" as="sourcePoint" /><mxPoint x="955" y="400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c15" value="&lt;b&gt;[password correct]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="404" width="420" height="22" as="geometry" /></mxCell>
        <mxCell id="c16" value="6. INSERT session (new random token)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="470" as="sourcePoint" /><mxPoint x="880" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c17" value="7. 200 OK: token, username, role" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="520" as="sourcePoint" /><mxPoint x="360" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c18" value="8. keep the token in Session;&lt;br&gt;manager app: refuse if role is not MANAGER" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="372" y="540" width="185" height="56" as="geometry" /></mxCell>
        <mxCell id="c19" value="9. open the main screen" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="640" as="sourcePoint" /><mxPoint x="100" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c20" value="" style="endArrow=none;html=1;strokeColor=#333333;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="680" as="sourcePoint" /><mxPoint x="955" y="680" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c21" value="&lt;b&gt;[user not found or password wrong]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="684" width="420" height="22" as="geometry" /></mxCell>
        <mxCell id="c22" value="10. 401 Unauthorized" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="750" as="sourcePoint" /><mxPoint x="360" y="750" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c23" value="11. show &quot;Wrong username or password&quot;" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="800" as="sourcePoint" /><mxPoint x="100" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c24" value="Covers FR1, FR2, FR11, N2, N3. The same flow is used by both apps; only the screen opened at the end differs." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="520" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
