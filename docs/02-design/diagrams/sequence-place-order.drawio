        <mxCell id="c1" value="Customer" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="c2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="90" as="sourcePoint" /><mxPoint x="90" y="900" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c3" value="Customer app&lt;br&gt;(JavaFX)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="c4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="90" as="sourcePoint" /><mxPoint x="290" y="900" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c5" value="order-service&lt;br&gt;(Flask)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="c6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="90" as="sourcePoint" /><mxPoint x="490" y="900" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c7" value="user-service&lt;br&gt;(HttpServer)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="650" y="40" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="c8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="90" as="sourcePoint" /><mxPoint x="720" y="900" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c9" value="book-service&lt;br&gt;(Flask)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="850" y="40" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="c10" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="90" as="sourcePoint" /><mxPoint x="920" y="900" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c11" value="MySQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="40" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="c12" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="90" as="sourcePoint" /><mxPoint x="1110" y="900" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c13" value="bills/ folder" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1220" y="40" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="c14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="90" as="sourcePoint" /><mxPoint x="1290" y="900" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c15" value="1. click &quot;Place order&quot;" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="140" as="sourcePoint" /><mxPoint x="290" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c16" value="2. POST /api/orders (token, items) — asynchronous" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="190" as="sourcePoint" /><mxPoint x="490" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c17" value="3. GET /api/auth/session (token)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="240" as="sourcePoint" /><mxPoint x="720" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c18" value="4. find session by token" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="290" as="sourcePoint" /><mxPoint x="1110" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c19" value="5. session + role" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="340" as="sourcePoint" /><mxPoint x="720" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c20" value="6. valid, role = CUSTOMER" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="390" as="sourcePoint" /><mxPoint x="490" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c21" value="7. GET /api/books/{id} (for each book)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="440" as="sourcePoint" /><mxPoint x="920" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c22" value="8. price, copies available" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="490" as="sourcePoint" /><mxPoint x="490" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c23" value="9. calculate charges:&lt;br&gt;buy = price, rent = 10% of price,&lt;br&gt;rent due date = today + 7 days" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="502" y="510" width="200" height="56" as="geometry" /></mxCell>
        <mxCell id="c24" value="10. INSERT order + items (payment status PENDING)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="600" as="sourcePoint" /><mxPoint x="1110" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c25" value="11. order id" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="650" as="sourcePoint" /><mxPoint x="490" y="650" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c26" value="12. write bill-&amp;lt;orderId&amp;gt;.html" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="700" as="sourcePoint" /><mxPoint x="1290" y="700" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c27" value="13. 201 Created: order + bill" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="750" as="sourcePoint" /><mxPoint x="290" y="750" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c28" value="14. show the bill" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="800" as="sourcePoint" /><mxPoint x="90" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c29" value="The window stays usable between steps 2 and 13, because the call runs in the background (N2)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="420" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
