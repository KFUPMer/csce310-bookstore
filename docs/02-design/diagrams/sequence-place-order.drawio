<mxfile host="app.diagrams.net">
  <diagram id="sequence-place-order" name="Sequence: place an order">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Customer" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="25" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="90" as="sourcePoint" /><mxPoint x="100" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c3" value="Customer app&lt;br&gt;(JavaFX)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="225" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="90" as="sourcePoint" /><mxPoint x="300" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c5" value="order-service&lt;br&gt;(Flask)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="425" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="90" as="sourcePoint" /><mxPoint x="500" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c7" value="user-service&lt;br&gt;(HttpServer)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="625" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="90" as="sourcePoint" /><mxPoint x="700" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c9" value="book-service&lt;br&gt;(Flask)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="825" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c10" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="90" as="sourcePoint" /><mxPoint x="900" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c11" value="MySQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1025" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c12" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="90" as="sourcePoint" /><mxPoint x="1100" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c13" value="bills/ folder" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1225" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="90" as="sourcePoint" /><mxPoint x="1300" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c15" value="Mail server" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1425" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c16" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="90" as="sourcePoint" /><mxPoint x="1500" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c17" value="1. click &quot;Place order&quot;" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="140" as="sourcePoint" /><mxPoint x="300" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c18" value="2. POST /api/orders (token, items) — asynchronous" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="190" as="sourcePoint" /><mxPoint x="500" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c19" value="3. GET /api/auth/session (token)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="240" as="sourcePoint" /><mxPoint x="700" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c20" value="4. valid, role = CUSTOMER, email" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="290" as="sourcePoint" /><mxPoint x="500" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c21" value="5. GET /api/books/{id} (for each book)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="340" as="sourcePoint" /><mxPoint x="900" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c22" value="6. title, price, copies available" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="390" as="sourcePoint" /><mxPoint x="500" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c23" value="7. calculate charges: buy = price,&lt;br&gt;rent = 10% of price, due in 7 days" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="512" y="410" width="185" height="56" as="geometry" /></mxCell>
        <mxCell id="c24" value="8. INSERT order + items (payment status PENDING)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="510" as="sourcePoint" /><mxPoint x="1100" y="510" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c25" value="9. order id" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="560" as="sourcePoint" /><mxPoint x="500" y="560" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c26" value="10. PATCH /api/books/{id}/copies (one less, for each book)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="610" as="sourcePoint" /><mxPoint x="900" y="610" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c27" value="11. write bill-&amp;lt;orderId&amp;gt;.html" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="660" as="sourcePoint" /><mxPoint x="1300" y="660" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c28" value="12. send the bill to the customer email" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="710" as="sourcePoint" /><mxPoint x="1500" y="710" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c29" value="13. 201 Created: order + bill" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="760" as="sourcePoint" /><mxPoint x="300" y="760" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c30" value="14. show the bill" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="810" as="sourcePoint" /><mxPoint x="100" y="810" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c31" value="Covers FR6–FR10. If a book has no copies left, order-service answers 409 Conflict at step 6 and nothing is saved." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="520" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
