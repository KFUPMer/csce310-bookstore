        <mxCell id="c17" value="7. INSERT user (role CUSTOMER)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="540" as="sourcePoint" /><mxPoint x="880" y="540" as="targetPoint" /></mxGeometry></mxCell>
