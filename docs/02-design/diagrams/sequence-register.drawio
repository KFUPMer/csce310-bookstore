        <mxCell id="c22" value="10. 409 Conflict" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="750" as="sourcePoint" /><mxPoint x="360" y="750" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c23" value="11. show &quot;Username or email already in use&quot;" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="800" as="sourcePoint" /><mxPoint x="100" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c24" value="Covers FR3 and N3 (extra credit). New accounts are always customers; managers are created by the seed script." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="520" height="56" as="geometry" /></mxCell>
