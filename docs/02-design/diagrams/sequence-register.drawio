        <mxCell id="c9" value="1. fill in username, email, password; click &quot;Create account&quot;" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="140" as="sourcePoint" /><mxPoint x="360" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c10" value="2. check the fields are filled in&lt;br&gt;and the email looks valid" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="372" y="160" width="185" height="56" as="geometry" /></mxCell>
        <mxCell id="c11" value="3. POST /api/users/register — asynchronous" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="260" as="sourcePoint" /><mxPoint x="620" y="260" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c12" value="4. is the username or email already used?" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="310" as="sourcePoint" /><mxPoint x="880" y="310" as="targetPoint" /></mxGeometry></mxCell>
