        <mxCell id="c15" value="&lt;b&gt;[username and email are free]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="404" width="420" height="22" as="geometry" /></mxCell>
