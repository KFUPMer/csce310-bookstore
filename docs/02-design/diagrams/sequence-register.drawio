        <mxCell id="c19" value="9. show &quot;Account created&quot;, go to log in" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="640" as="sourcePoint" /><mxPoint x="100" y="640" as="targetPoint" /></mxGeometry></mxCell>
