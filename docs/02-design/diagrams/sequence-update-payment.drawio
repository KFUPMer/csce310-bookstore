<mxfile host="app.diagrams.net">
  <diagram id="sequence-update-payment" name="Sequence: manager updates payment status">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Manager" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="25" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="90" as="sourcePoint" /><mxPoint x="100" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c3" value="Manager app&lt;br&gt;(JavaFX)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="265" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="90" as="sourcePoint" /><mxPoint x="340" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c5" value="order-service&lt;br&gt;(Flask)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="505" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="90" as="sourcePoint" /><mxPoint x="580" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c7" value="user-service&lt;br&gt;(HttpServer)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="745" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="90" as="sourcePoint" /><mxPoint x="820" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c9" value="MySQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="985" y="40" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="c10" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="90" as="sourcePoint" /><mxPoint x="1060" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c11" value="1. open the Orders tab" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="140" as="sourcePoint" /><mxPoint x="340" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c12" value="2. GET /api/orders — asynchronous" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="190" as="sourcePoint" /><mxPoint x="580" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c13" value="3. GET /api/auth/session (token)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="240" as="sourcePoint" /><mxPoint x="820" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c14" value="4. valid, role = MANAGER" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="290" as="sourcePoint" /><mxPoint x="580" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c15" value="5. SELECT all orders" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="340" as="sourcePoint" /><mxPoint x="1060" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c16" value="6. 200 OK: list of orders" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="390" as="sourcePoint" /><mxPoint x="340" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c17" value="7. select an order, click &quot;Mark as paid&quot;" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="440" as="sourcePoint" /><mxPoint x="340" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c18" value="8. PATCH /api/orders/{id}/payment-status {PAID}" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="490" as="sourcePoint" /><mxPoint x="580" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c19" value="9. UPDATE order SET payment_status = PAID" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="540" as="sourcePoint" /><mxPoint x="1060" y="540" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c20" value="10. 200 OK: updated order" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="590" as="sourcePoint" /><mxPoint x="340" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c21" value="11. the row now shows &quot;Paid&quot;" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="640" as="sourcePoint" /><mxPoint x="100" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c22" value="Covers FR12, FR13, N5. A customer token gets 403 Forbidden at step 4. The session check is repeated for the PATCH (not drawn twice)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="520" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
