<mxfile host="app.diagrams.net">
  <diagram id="state-machine" name="State machines">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Order" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="c2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Being selected&lt;/b&gt;&lt;br&gt;&lt;i&gt;do: add / remove books,&lt;br&gt;choose buy or rent&lt;/i&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="70" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Pending&lt;/b&gt;&lt;br&gt;&lt;i&gt;bill saved as HTML,&lt;br&gt;waiting for payment&lt;/i&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Paid&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1130" y="70" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="c6" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1440" y="95" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c7" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="customer places order&lt;br&gt;/ save order, generate bill" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="manager marks it paid,&lt;br&gt;or the customer pays (demo checkout)" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="User session" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="c12" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c13" value="&lt;b&gt;Logged out&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="290" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="c14" value="&lt;b&gt;Logged in&lt;/b&gt;&lt;br&gt;&lt;i&gt;do: send session token&lt;br&gt;with every request&lt;/i&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="c15" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="login [username and password valid]&lt;br&gt;/ create session token" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="logout / delete session" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="login [not valid] / show error: the user stays Logged out." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="400" width="340" height="40" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
