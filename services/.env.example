# Copy this file to ".env" in the same folder and fill in the values.
# The real .env is ignored by git: never commit passwords.

# --- user-service
# "mysql" (default) or "memory" (no database: test accounts only, nothing is kept)
STORAGE=mysql
USER_SERVICE_PORT=8081

# --- MySQL (user-service, order-service)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bookstore

# --- MongoDB (book-service)
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=bookstore
BOOK_SERVICE_PORT=8082

# --- order-service
ORDER_SERVICE_PORT=8083
# Where bills are saved. Empty means services/order-service/bills
BILLS_FOLDER=

# --- Where the other services find user-service, and order-service finds book-service
USER_SERVICE_URL=http://127.0.0.1:8081
BOOK_SERVICE_URL=http://127.0.0.1:8082

# --- Shared key for service-to-service calls (order-service -> book-service)
SERVICE_KEY=

# --- Email: bills are sent through Gmail (FR10).
# Leave SMTP_USER and SMTP_PASSWORD empty to switch email off: bills are still saved.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# A Gmail "app password" created for this project, not the account password
SMTP_PASSWORD=
MAIL_FROM=
